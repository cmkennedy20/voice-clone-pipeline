# ==============================================================================
# Voice Clone Pipeline & Studio — WSL2 on Windows Environment Reference (.env)
# ==============================================================================
# Quick start inside WSL2 (Ubuntu/Debian):
#   make setup          # Auto-detects WSL2 GPU, VRAM, RAM, Windows LAN IP & secrets
#   make up             # Compiles containers, pulls models, migrates DB & starts Web App
#
# Copy this file to `.env` only if you want to configure every value manually;
# `make setup` creates `.env` automatically and preserves any secrets already set.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. COMPUTE MODE & WSL2 GPU SELECTION
# ------------------------------------------------------------------------------
# COMPUTE_MODE:
#   - `gpu` : Attaches `docker-compose.gpu.yml` for WSL2 NVIDIA CUDA acceleration (recommended).
#   - `cpu` : Runs purely on CPU (works on any WSL2/Linux machine without an NVIDIA GPU).
COMPUTE_MODE=gpu

# COMPUTE_BACKEND / TORCH_COMPUTE (Docker build-time acceleration flags):
#   - NVIDIA GPU:  COMPUTE_BACKEND=cuda  and  TORCH_COMPUTE=cu121
#   - CPU-only:    COMPUTE_BACKEND=cpu   and  TORCH_COMPUTE=cpu
COMPUTE_BACKEND=cuda
TORCH_COMPUTE=cu121

# NVIDIA_GPU_ID:
#   - GPU index (`0`, `1`, ...) OR full GPU UUID (`GPU-xxxxxxxx-...` from `nvidia-smi -L`).
#   - Single-GPU Windows PCs should leave `0`.
#   - Multi-GPU PCs: `scripts/setup.sh` automatically selects your highest-VRAM NVIDIA GPU.
NVIDIA_GPU_ID=0

# CUDA_ARCHITECTURES:
#   - Semicolon-separated SM targets compiled into `whisper-rs` and `llama-server`:
#     `75` = RTX 20xx (Turing), `80` = A100, `86` = RTX 30xx (Ampere), `89` = RTX 40xx/50xx (Ada/PTX).
CUDA_ARCHITECTURES="75;80;86;89"

# Container-internal CUDA visibility for the Python TTS sidecar (`0` inside the reserved GPU container, or `""` on CPU):
TTS_CUDA_VISIBLE_DEVICES=0

# Enable GPU acceleration inside `api-server` Whisper ASR (`true` for NVIDIA GPU, `false` for CPU-only):
WHISPER_USE_GPU=true

# ------------------------------------------------------------------------------
# 2. HARDWARE TIER MODEL SIZING (Adjust to fit your GPU VRAM or WSL2 VM RAM)
# ------------------------------------------------------------------------------
# Recommended presets (auto-configured by `make setup` / `scripts/setup.sh`):
#
# | Tier / Hardware         | WHISPER_MODEL_FILE   | LLM_HF_REPO          | LLM_MODEL_FILE           | LLM_GPU_LAYERS | PULL_COSYVOICE | PREWARM_ENGINES     |
# |-------------------------|----------------------|----------------------|--------------------------|----------------|----------------|---------------------|
# | Enthusiast (>=16GB VRAM)| ggml-large-v3.bin    | Qwen/Qwen3-8B-GGUF   | Qwen3-8B-Q8_0.gguf       | 99             | true           | cosyvoice_3,xtts_v2 |
# | Mainstream (8-15GB VRAM)| ggml-medium.bin      | Qwen/Qwen3-8B-GGUF   | Qwen3-8B-Q4_K_M.gguf     | 99             | true           | xtts_v2             |
# | Entry GPU  (4-7GB VRAM) | ggml-small.bin       | Qwen/Qwen3-4B-GGUF   | Qwen3-4B-Q4_K_M.gguf     | 28             | false          | xtts_v2             |
# | CPU-Only   (>=16GB RAM) | ggml-small.bin       | Qwen/Qwen3-4B-GGUF   | Qwen3-4B-Q4_K_M.gguf     | 0              | false          | (leave empty)       |
# ------------------------------------------------------------------------------
WHISPER_HF_REPO=ggerganov/whisper.cpp
WHISPER_MODEL_FILE=ggml-large-v3.bin

LLM_HF_REPO=Qwen/Qwen3-8B-GGUF
LLM_MODEL_FILE=Qwen3-8B-Q8_0.gguf
LLM_GPU_LAYERS=99
LLM_CPU_THREADS=4
LLM_CTX_SIZE=4096

# CosyVoice 3.0 & XTTS-v2 sidecar settings:
# Set `PULL_COSYVOICE=false` on <=7 GB VRAM or CPU-only systems to save ~4 GB disk & VRAM.
PULL_COSYVOICE=true
COSYVOICE_HF_REPO=FunAudioLLM/CosyVoice2-0.5B
PREWARM_ENGINES=cosyvoice_3,xtts_v2
INSTALL_EXTRA_TTS_PACKAGES=true

# Optional Hugging Face access token (only needed if pulling gated custom repos or hitting rate limits):
HF_TOKEN=

# ------------------------------------------------------------------------------
# 3. WSL2 HOST STORAGE PATHS (~6–18 GB of HuggingFace weights & enrolled voices)
# ------------------------------------------------------------------------------
# Keep paths on native WSL2 Linux ext4 (e.g. `./models` inside `~/voice-clone-pipeline`
# or `/home/<you>/voice-models`) for fast NVMe I/O. If you must store weights on another
# Windows drive (e.g. `D:`), use `/mnt/d/VoiceCloneStudio/models` inside WSL2.
STUDIO_MODELS_DIR=./models
STUDIO_STORAGE_DIR=./local_storage

# Container-internal paths (do not change unless modifying `docker-compose.yml` mounts):
WHISPER_MODEL_PATH=/models/whisper/ggml-large-v3.bin
SILERO_VAD_MODEL_PATH=/models/vad/silero_vad.onnx
TRANSLATOR_BASE_URL=http://qwen-translator:8081
TTS_SIDECAR_URL=http://tts-clone-sidecar:8082
STORAGE_DIR=/storage

# ------------------------------------------------------------------------------
# 4. NETWORK PORTS & WINDOWS BROWSER MICROPHONE ACCESS
# ------------------------------------------------------------------------------
# - On the Windows Host PC: open `http://localhost:3000` in Chrome or Edge. WSL2 forwards
#   `localhost` automatically, and `localhost` is a W3C Secure Context so microphone
#   recording works out of the box with zero TLS warnings!
# - From another device on your Wi-Fi/LAN (phone/laptop): `scripts/setup.sh` auto-detects
#   your Windows host's LAN IPv4 (`LAN_HOST_IP`) for `https://<LAN_HOST_IP>:3443`.
LAN_HOST_IP=127.0.0.1
WEB_UI_PORT=3000
WEB_UI_TLS_PORT=3443
API_BIND_PORT=8080
API_BIND_ADDR=0.0.0.0:8080
API_SERVER_INTERNAL_URL=http://api-server:8080

# ------------------------------------------------------------------------------
# 5. LOCAL DATABASE & API SECURITY SECRETS
# ------------------------------------------------------------------------------
# `make setup` automatically generates cryptographically random secrets on first run.
POSTGRES_PASSWORD=local_voice_dev
DATABASE_URL=postgres://voice_pipe:local_voice_dev@postgres:5432/voice_pipe

# Shared owner bearer secret guarding `/api/v1/*` (injected automatically into `web-ui` Nginx proxy).
# Generate manually with: `openssl rand -hex 32`
OWNER_API_BEARER_TOKEN=replace-with-32-byte-random-hex-owner-token

# ------------------------------------------------------------------------------
# 6. OPTIONAL DISCORD 1-ON-1 BOT & SLASH COMMANDS (`/speak`, `/voice_clone`)
# ------------------------------------------------------------------------------
# Leave the placeholders below to run the Web Studio UI & REST API without Discord!
# `discord-worker` stands by quietly with zero crash loops until you pair Discord via:
#   - Studio Web UI (`Tab 5 -> Pair Discord Bot` — hot-activates within 3 seconds!), OR
#   - CLI wizard (`make setup-discord`).
DISCORD_APPLICATION_ID=100000000000000000
DISCORD_BOT_TOKEN=replace-with-discord-application-bot-token
DISCORD_OWNER_USER_ID=100000000000000001

# ------------------------------------------------------------------------------
# 7. QUALITY GATE & LOGGING TUNING
# ------------------------------------------------------------------------------
# Maximum Character Error Rate in basis points (`1200` = `12.00%` max reverse-ASR CER):
MAX_CER_BPS=1200
MAX_TTS_ATTEMPTS=3

# Structured Rust tracing filter:
RUST_LOG=info,api=debug,features=debug,framework=info
