{
  "manifest_version": "1.0.0",
  "description": "RTX 3090 Layer-7 release evaluation suite: 15 golden English-to-Mandarin utterances, 3 Gate-0 DSP traps, and M1-M6 BasisPoints thresholds.",
  "thresholds": {
    "gate0_accuracy_bps": 10000,
    "digit_hygiene_bps": 10000,
    "max_mean_cer_bps": 1000,
    "max_clip_cer_bps": 1200,
    "min_speaker_sim_bps": 7800,
    "format_compliance_bps": 10000,
    "max_p95_latency_ms": 5000,
    "max_peak_vram_mib": 22016
  },
  "gate0_traps": [
    {
      "id": "trap_01_silent_too_short",
      "trap_kind": "silent_too_short",
      "description": "Sub-400ms near-silent mic tap that must be rejected before acquiring the GPU semaphore.",
      "total_duration_ms": 260,
      "voiced_duration_ms": 180,
      "clipped_samples_bps": 0,
      "expected_rejection_category": "silent_too_short"
    },
    {
      "id": "trap_02_heavily_clipped",
      "trap_kind": "heavily_clipped",
      "description": "Overdriven input exceeding the 50 bps (0.50%) full-scale clipping ceiling.",
      "total_duration_ms": 3000,
      "voiced_duration_ms": 2800,
      "clipped_samples_bps": 185,
      "expected_rejection_category": "heavily_clipped"
    },
    {
      "id": "trap_03_runaway_duration",
      "trap_kind": "runaway_duration",
      "description": "Open-mic recording exceeding the 120,000 ms (2-minute) maximum clip boundary.",
      "total_duration_ms": 126000,
      "voiced_duration_ms": 124500,
      "clipped_samples_bps": 0,
      "expected_rejection_category": "runaway_duration"
    }
  ],
